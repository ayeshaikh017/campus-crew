NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campuscrew
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=campuscrew_token
CLIENT_ORIGIN=http://localhost:5173
# Optional SMTP. If SMTP_HOST is blank, development OTP is printed in the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusCrew <no-reply@campuscrew.local>
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=30
